{
  name: Compilar Canaima Engine
on: workflow_dispatch

jobs:
  build:
    runs-on: windows-latest
    steps:
      - name: Descargando Código
        uses: actions/checkout@v4

      - name: Preparando Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '14'

      - name: Instalando Herramientas de Construccion
        run: |
          npm install -g electron-builder
          cd newIDE/app
          npm install --save-dev electron-builder electron --legacy-peer-deps

      - name: Fabricando Canaima Engine 32bits
        run: |
          cd newIDE/app
          npx electron-builder --win --ia32 -c.compression=store -c.win.target=portable
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Entregar Motor Listo
        uses: actions/upload-artifact@v4
        with:
          name: Canaima-Engine-32bits
          path: newIDE/app/dist/*.exe

