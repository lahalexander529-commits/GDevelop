{
  "name": "canaima-engine",
  "productName": "Canaima Engine",
  "version": "5.0.129",
  "description": "Motor de juegos Premium optimizado para 32-bits y 2GB de RAM.",
  "author": "Canaima Engine Community",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist:ia32": "electron-builder --win --ia32"
  },
  "build": {
    "appId": "com.canaima.engine",
    "productName": "Canaima Engine Premium Free",
    "directories": {
      "buildResources": "resources"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["ia32"]
        },
        {
          "target": "portable",
          "arch": ["ia32"]
        }
      ]
    }
  }
}
