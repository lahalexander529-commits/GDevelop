{
  "name": "canaima-engine",
  "productName": "Canaima Engine",
  "version": "5.0.129",
  "description": "Motor de juegos Premium optimizado para 32-bits. Exportación Multiplataforma.",
  "author": "Canaima Engine Community",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:ia32": "electron-builder --win --ia32"
  },
  "dependencies": {
    "electron-is-dev": "1.1.0"
  },
  "devDependencies": {
    "electron": "9.4.0",
    "electron-builder": "22.9.1"
  },
  "build": {
    "appId": "com.canaima.engine",
    "productName": "Canaima Engine Premium Free",
    "directories": {
      "buildResources": "resources"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["ia32"]
        }
      ]
    }
  }
}
